# Copy to .env and adjust. Real environment variables override these.

# TAK Server streaming endpoint. The scheme picks the transport:
#   wss://host:8443/takproto/1   TAK Server WebSocket API (protobuf)
#   tcp://host:8087              FreeTAKServer raw CoT, no TLS
#   tls://host:8089              FreeTAKServer raw CoT over SSL (client cert)
TAK_WS_URL=wss://10.4.1.42:8443/takproto/1

# Client certificate for mutual TLS (PKCS#12) and its password.
TAK_CLIENT_P12=C:\Users\Ryan Francisco\AppData\Roaming\WinTAK\SslCerts\client_39b0d9ef.p12
TAK_P12_PASSWORD=atakatak

# Self-signed server certs are accepted by default. To verify instead,
# set TAK_VERIFY_SSL=true and point TAK_CA_FILE at a PEM CA bundle.
TAK_VERIFY_SSL=false
TAK_CA_FILE=

# Optional extra CoT source: a UDP listener run alongside the stream above.
#   udp://host:port
# A multicast host (224-239.x) joins that group; a host that isn't a local
# interface (e.g. the server IP) falls back to binding all interfaces on the
# port, so datagrams sent to any local IP on that port are still received.
# Leave empty to disable.
TAK_UDP_URL=udp://10.4.1.42:6969

# Seconds past CoT stale time before a device is treated as offline and
# removed from the dashboard (it reappears the moment it is seen again).
TAK_OFFLINE_GRACE_SECONDS=60

# Plotted objects (markers, drawings) come from two sources: the live CoT
# stream (real-time) and this WinTAK SQLite store polled read-only for the
# full current set. Defaults to %APPDATA%\WinTAK\Databases\statesaver.sqlite.
# Set empty to rely on the live stream alone.
TAK_STATESAVER_PATH=
TAK_STATESAVER_POLL_SECONDS=10

# TAK Server Marti API — the authoritative connected-client list, polled with
# the same client cert. Shows a client's true Connected/Disconnected status
# even when its SA isn't relayed to our CoT subscription. Defaults to the
# TAK_WS_URL host on https. Set empty to disable.
TAK_MARTI_URL=
TAK_MARTI_POLL_SECONDS=8

# Routine plotted-object check: every interval each object is re-verified
# against the statesaver, recent CoT traffic, and its stale time. Missing
# objects are removed immediately; expired ones after this many consecutive
# failed checks. Set the interval to 0 to disable.
TAK_OBJECT_CHECK_SECONDS=30
TAK_OBJECT_CHECK_MISSES=3
