# Copy to .env.docker and pass with:  docker compose --env-file .env.docker up -d --build
# These override the ${VAR} defaults in docker-compose.yml.

# --- TAK server connection ---
TAK_WS_URL=wss://10.4.1.42:8443/takproto/1
TAK_P12_PASSWORD=atakatak
TAK_UDP_URL=udp://10.4.1.42:6969

# --- Host paths bind-mounted into the container (Windows form, forward slashes) ---
# Directory holding the WinTAK client certificate, and the cert's filename:
TAK_CERT_DIR=C:/Users/Ryan Francisco/AppData/Roaming/WinTAK/SslCerts
TAK_P12_NAME=client_39b0d9ef.p12
# Directory holding statesaver.sqlite (WinTAK Databases):
TAK_DB_DIR=C:/Users/Ryan Francisco/AppData/Roaming/WinTAK/Databases

# --- Routine plotted-object check (optional overrides) ---
# Interval for re-verifying plotted objects (0 disables); consecutive failed
# checks before an expired object is pruned (missing ones go immediately).
#TAK_OBJECT_CHECK_SECONDS=30
#TAK_OBJECT_CHECK_MISSES=3

# --- Django ---
DJANGO_SECRET_KEY=please-change-me
